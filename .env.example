# ================================================================
# RosMetrics — Konfigurasi (Supabase)
# ================================================================
# File ini hanya REFERENSI. Nilai rahasia JANGAN di-commit ke Git.
# Backend membaca nilai ini sebagai Supabase secrets, bukan dari file:
#
#   supabase secrets set JWT_SECRET="$(openssl rand -hex 32)" \
#                        CORS_ORIGIN="https://domain-frontend-kamu.com"
#
# SUPABASE_DB_URL / SUPABASE_URL disediakan otomatis oleh Supabase.
# ================================================================

# Wajib. String acak min. 32 karakter. Mengganti nilai ini membuat
# semua token login yang sedang aktif tidak berlaku (user harus login ulang).
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_MIN_32_KARAKTER

# URL frontend (tanpa trailing slash). Default "*" (semua origin).
CORS_ORIGIN=https://domain-frontend-kamu.com

# "true" hanya saat debugging — menampilkan pesan error database.
APP_DEBUG=false

# Paginasi daftar UMKM
PAGE_LIMIT_DEFAULT=15
PAGE_LIMIT_MAX=100
